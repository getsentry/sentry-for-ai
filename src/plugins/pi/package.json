{
  "name": "@sentry/pi-plugin",
  "version": "1.2.0",
  "description": "Sentry skills and MCP integration for Pi",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Sentry",
    "url": "https://sentry.io"
  },
  "repository": {
